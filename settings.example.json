{
  "skillListingBudgetFraction": 0.02,
  "env": {
    "CLAUDE_CODE_EVEN_MORE_DANGEROUSLY_SKIP_PERMISSIONS": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "0",
    "CLAUDE_CODE_SIMPLE_SYSTEM_PROMPT": "1",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "skillOverrides": {
    "anthropic-skills:artifact-emulator": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^(?!(AskUserQuestion|ExitPlanMode)$).*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "concise@concise": true
  },
  "extraKnownMarketplaces": {
    "concise": {
      "source": {
        "source": "github",
        "repo": "dayfinggg/anthropic-claude-code-agent-skills"
      },
      "autoUpdate": true
    }
  },
  "language": "russian",
  "feedbackSurveyRate": 0,
  "feedbackDrafts": "off",
  "spinnerTipsEnabled": false,
  "effortLevel": "high",
  "model": "claude-opus-5-5",
  "promptSuggestionEnabled": false,
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "showTurnDuration": false,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
